{
  "permissions": {
    "allow": [
      "Read(**/*)",
      "Write(**/*)",
      "Shell(git)",
      "Shell(npm)",
      "Shell(npx)",
      "Shell(node)",
      "Shell(pnpm)",
      "Shell(rg)",
      "Shell(grep)",
      "Shell(find)",
      "Shell(ls)",
      "Shell(cat)",
      "Shell(head)",
      "Shell(tail)",
      "Shell(docker)",
      "Shell(docker-compose)"
    ],
    "deny": [
      "Shell(gh)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(**/*.key)",
      "Write(**/*secret*)",
      "Write(**/credentials*)"
    ]
  }
}
